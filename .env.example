APP_PORT=8010
TTS_FALLBACK_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+20%
TTS_MAX_CONCURRENCY=4
TTS_TIMEOUT_SECONDS=30
MAX_TEXT_LENGTH=1000
RATE_LIMIT_PER_MINUTE=60
MAX_TRANSLATE_LENGTH=10000
# Gemini là nhà cung cấp dịch duy nhất. Để trống thì /api/translate trả 503.
# GEMINI_MAX_PER_DAY là trần CHI PHÍ; đặt 0 để tắt Gemini mà không xoá key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MAX_PER_DAY=50
GEMINI_TIMEOUT_SECONDS=60
CACHE_DIR=mp3
CACHE_MAX_MB=512
CACHE_CHECK_EVERY=50
LOG_LEVEL=INFO
GTTS_MAX_PER_MINUTE=20
GTTS_FAILURE_THRESHOLD=3
GTTS_COOLDOWN_SECONDS=300
GTTS_MAX_COOLDOWN_SECONDS=3600
